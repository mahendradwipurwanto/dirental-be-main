{
  "name": "rental-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/dev.ts",
    "start": "node --env-file=.env --import tsx src/dev.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env node_modules/vitest/vitest.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env --import tsx src/db/seed.ts",
    "gen:openapi": "node --env-file=.env --import tsx scripts/gen-openapi.ts",
    "check:openapi": "node --env-file=.env --import tsx scripts/gen-openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@date-fns/tz": "^1.5.0",
    "@node-rs/argon2": "^2.2.0",
    "@vercel/functions": "^3.9.5",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "nanoid": "^6.0.1",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "~4.1.11"
  }
}

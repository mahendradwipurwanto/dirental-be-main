# Postgres (self-hosted). Use a pooler (PgBouncer, transaction mode) in production if max_connections is small.
DATABASE_URL=postgres://rental:rental@localhost:5434/rental

NODE_ENV=development
PORT=4000

# 32+ random bytes, base64 or hex
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
# Shared secret rental-web sends as "x-web-key" on server-side calls (booking mutations)
WEB_API_KEY=change-me
# Shared secret the API sends to rental-web /api/revalidate
REVALIDATE_SECRET=change-me

# Public URLs of the other two apps
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# S3-compatible object storage (Sumopod / Cloudeka). Public assets live under public/* (bucket policy makes
# them readable), payment proofs under private/* (served only through the API). Bucket CORS must allow PUT.
S3_ENDPOINT=https://your-endpoint.example
S3_REGION=your-region
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Optional: CDN in front of the bucket for public objects
S3_PUBLIC_BASE_URL=

# SMTP (Sumopod). If SMTP_HOST is empty, emails are logged to stdout instead of sent.
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rental Platform <noreply@example.com>"

# Seed script
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
